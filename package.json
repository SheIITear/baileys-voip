  "version": "0.1.0",
  "description": "Pure Node.js WhatsApp VoIP stack scaffold with local crypto, transport, and stanza handling",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/vendor/**/*"
